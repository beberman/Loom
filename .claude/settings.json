{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(tools/loom.sh:*)",
      "Bash(tools/loom-test.sh:*)",
      "Bash(tools/loom-serve.sh:*)",
      "Bash(tools/next-doc-id.sh:*)",
      "Bash(./tools/loom.sh:*)",
      "Bash(./tools/loom-test.sh:*)",
      "Bash(./tools/loom-serve.sh:*)",
      "Bash(./tools/next-doc-id.sh:*)",
      "Bash(sbcl --script:*)",
      "Bash(/usr/bin/sbcl --script:*)",
      "Bash(/usr/bin/sbcl:*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(printf:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(python3 -)",
      "Bash(python -)",
      "Skill(loom)",
      "Read(./**)",
      "Edit(./**)",
      "Write(./docs/**)",
      "Write(./src/**)",
      "Write(./tools/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/loom-serve.sh update",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 $CLAUDE_PROJECT_DIR/tools/allow-loom.py"
          }
        ]
      }
    ]
  }
}
