;;;
;;; Tests for the generated architecture document (REQ-0021 R5/R6, DES-0022 S3).
;;;
;;; Most of these assert what the generator refuses to say. That is the whole
;;; of R6 -- "a generated invariant is a defect" -- and a generator is easy to
;;; write and hard to keep honest, because the failure mode is prose that reads
;;; well and asserts something nobody measured.
;;;

(in-package :synoptik-workspace-test)

(def-suite architecture
  :in all-tests
  :description "GENERATE-ARCHITECTURE: only what was measured, and it says so.")

(in-suite architecture)

(defun arch-tree-fixture (root)
  "A small source tree with two systems, a protocol, and an ambiguous name."
  (write-document root "src/alpha.lisp"
                  "(defpackage :alpha (:use :cl) (:export #:render #:alpha-hub))
(in-package :alpha)
(defgeneric render (thing))
(defun alpha-hub (x) x)
(defun alpha-entry (x) (alpha-hub (render x)))
")
  ;; `collide' is defined in both packages, so it names two entities and a
  ;; reference to it resolves to neither.
  (write-document root "src/beta.lisp"
                  "(defpackage :beta (:use :cl) (:export #:collide))
(in-package :beta)
(defun collide (x) x)
(defmethod alpha::render ((thing string)) (collide thing))
")
  (write-document root "src/gamma.lisp"
                  "(defpackage :gamma (:use :cl) (:export #:collide))
(in-package :gamma)
(defun collide (y) y)
")
  root)

(defun generated-text (root doc-id &optional (docs "docs"))
  (document-text root (format nil "~a/arch/~a.yaml" docs doc-id)))

;;; ------------------------------------------------------------------
;;; What it refuses to say
;;; ------------------------------------------------------------------

(test the-invariants-section-is-empty-and-says-why
  ;; REQ-0021 R6. An absent section reads as an oversight and a filled one is
  ;; fabrication -- "code being consistent with an invariant is not evidence
  ;; the invariant was intended". An empty section that explains itself is the
  ;; only honest form, and it has to survive somebody deciding it looks unhelpful.
  (with-document-tree (root)
    (arch-tree-fixture root)
    (with-indexed-tree (repository root)
      (let* ((report (generate-architecture repository))
             (text (generated-text root (getf report :document))))
        (is (null (getf report :problems)) "~a" (getf report :problems))
        (is (search "invariants: |" text) "the section exists")
        (is (search "None." text) "and is empty")
        (is (search "not evidence" text)
            "and says why, rather than leaving a reader to assume it was missed")))))

(test the-document-says-it-was-generated-and-carries-its-commit
  ;; R9: provenance, and a status the rest of the system will not treat as
  ;; settled. `draft' is the one ARCH status that is not settled.
  (with-document-tree (root)
    (arch-tree-fixture root)
    (with-indexed-tree (repository root)
      (let* ((report (generate-architecture repository))
             (text (generated-text root (getf report :document))))
        (is (search "GENERATED by Synoptik" text))
        (is (search (format nil "~%status: draft~%") text)
            "generated documents are draft, or the rest of the system believes them")))))

(test the-layering-is-reported-in-both-directions-and-not-judged
  ;; Scoped to the dependencies section rather than to the whole document,
  ;; because the invariants section legitimately uses the word "violation"
  ;; while explaining why it will not name one -- "a violation is not evidence
  ;; that they did not". A blunter assertion failed on exactly that sentence,
  ;; which is the test being wrong rather than the document.
  (with-document-tree (root)
    (arch-tree-fixture root)
    (with-indexed-tree (repository root)
      (let* ((report (generate-architecture repository))
             (text (generated-text root (getf report :document)))
             (start (search "DEPENDENCIES BETWEEN SYSTEMS" text))
             (section (subseq text start (search "PROTOCOLS" text :start2 start))))
        (is (search "neither is judged" section))
        (is (search "not a finding" section))
        (dolist (word '("violation" "should" "must not" "wrong direction"))
          (is (not (search word section))
              "the dependencies section says ~s; naming an edge wrong asserts ~
an intent no index holds" word))))))

;;; ------------------------------------------------------------------
;;; The field R6 is measured by
;;; ------------------------------------------------------------------

(test an-ambiguous-name-is-kept-out-of-describes-and-counted
  ;; The mechanism behind R6's "unresolved does not rise". describes: resolves
  ;; through the same path every declared reference does, which refuses a name
  ;; matching several entities -- so an ambiguous name in that field would be
  ;; reported as a rotten reference by the very check R6 is measured against.
  (with-document-tree (root)
    (arch-tree-fixture root)
    (with-indexed-tree (repository root)
      (let ((graph (repository-graph repository)))
        (multiple-value-bind (kept dropped)
            (synoptik-workspace::unambiguous-names graph '("collide" "alpha-hub"))
          (is (member "alpha-hub" kept :test #'string=)
              "a name matching one entity is usable")
          (is (not (member "collide" kept :test #'string=))
              "a name matching two is not: ~a" kept)
          (is (= 1 dropped) "and the drop is counted rather than swallowed"))))))

(test a-generated-document-does-not-raise-unresolved
  ;; R6 end to end, and the single number the requirement turns on.
  (with-document-tree (root)
    (arch-tree-fixture root)
    (with-indexed-tree (repository root)
      (let ((before (length (unresolved-references (repository-graph repository)))))
        (generate-architecture repository)
        (reindex-repository repository :quiet t)
        (is (= before (length (unresolved-references (repository-graph repository))))
            "a generated document must not add a rotten reference")))))

;;; ------------------------------------------------------------------
;;; Create-only
;;; ------------------------------------------------------------------

(test a-second-run-writes-a-new-document-rather-than-overwriting
  ;; R9: re-running never silently rewrites a document a human has edited. The
  ;; id is allocated the same way every other document's is, so a second run
  ;; produces ARCH-0002 and leaves ARCH-0001 exactly as it was -- including
  ;; whatever invariants somebody filled in.
  (with-document-tree (root)
    (arch-tree-fixture root)
    (with-indexed-tree (repository root)
      (let* ((first-run (generate-architecture repository))
             (path (merge-pathnames (format nil "docs/arch/~a.yaml"
                                            (getf first-run :document))
                                    root)))
        (is (string= "ARCH-0001" (getf first-run :document)))
        ;; A human improves it.
        (with-open-file (out path :direction :output :if-exists :append)
          (write-string "  # a human added this
" out))
        (let ((edited (document-text root "docs/arch/ARCH-0001.yaml")))
          (reindex-repository repository :quiet t)
          (let ((second-run (generate-architecture repository)))
            (is (string= "ARCH-0002" (getf second-run :document))
                "the next free id, not the same one")
            (is (string= edited (document-text root "docs/arch/ARCH-0001.yaml"))
                "and the edited document is byte-for-byte what the human left")))))))

(test the-document-goes-where-the-manifest-said-documents-go
  ;; R2's choice is recorded for exactly this: a generator that assumed `docs'
  ;; would write into the wrong directory in precisely the trees that chose
  ;; otherwise, and would do it silently.
  (with-document-tree (root)
    (arch-tree-fixture root)
    (prepare-repository root :document-directory "knowledge")
    (with-indexed-tree (repository root)
      (let ((report (generate-architecture repository)))
        (is (null (getf report :problems)) "~a" (getf report :problems))
        (is (search "knowledge/arch/" (getf report :created))
            "written to ~a, not to docs/" (getf report :created))))))

(test a-tree-with-no-relationships-says-so-in-the-document
  ;; The front-end case carried through into the generated text: 27 entities, 0
  ;; relationships, and a document of empty sections that reads like a clean
  ;; simple architecture unless it says otherwise.
  (with-document-tree (root)
    (write-document root "docs/notes.md" "# Notes

Nothing here is source.
")
    (with-indexed-tree (repository root)
      (let* ((report (generate-architecture repository))
             (text (generated-text root (getf report :document))))
        (is (search "no analyzer claimed" text)
            "an unread tree has to say so before a reader draws a conclusion")))))

(test a-generated-document-records-itself-so-removal-can-account-for-it
  ;; R13b, and the gap found by running removal against a prepared copy: init
  ;; records what it wrote, but `architecture' writes later -- once there is an
  ;; index -- and did not. Full removal then met a document the manifest could
  ;; not account for and refused on it, which is R13a protecting the tree from
  ;; Synoptik's own output.
  (with-document-tree (root)
    (arch-tree-fixture root)
    (prepare-repository root)
    (with-indexed-tree (repository root)
      (let ((report (generate-architecture repository)))
        (is-true (getf report :recorded) "there is a manifest to record into")
        (is (member (getf report :created)
                    (synoptik-workspace::manifest-created-paths root)
                    :test #'string=)
            "the generated document is in the manifest: ~a"
            (synoptik-workspace::manifest-created-paths root)))
      ;; And the consequence that matters: full removal now completes.
      (let ((removal (remove-preparation root :mode :all)))
        (is (null (getf removal :problems)) "~a" (getf removal :problems))
        (is (null (probe-file (target-file root "docs/arch/ARCH-0001.yaml")))
            "full removal takes the document init generated")))))

(test a-generated-document-outside-a-prepared-tree-still-works
  ;; The complement: `architecture' is useful on any indexed repository, not
  ;; only a prepared one, and a missing manifest is not an error.
  (with-document-tree (root)
    (arch-tree-fixture root)
    (with-indexed-tree (repository root)
      (let ((report (generate-architecture repository)))
        (is (null (getf report :problems)) "~a" (getf report :problems))
        (is-false (getf report :recorded) "nothing to record into, and that is fine")))))

